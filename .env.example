# Copie locale : .env.local. Ne jamais committer les clés réelles.
# Dans Vercel : Project Settings > Environment Variables.
# Laisser une clé vide désactive le fournisseur correspondant.
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=gpt-4.1-mini

NEXUS_GROK_API_KEY=
NEXUS_GROK_MODEL=grok-3-mini

NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-2.5-flash

NEXUS_CLAUDE_API_KEY=
NEXUS_CLAUDE_MODEL=claude-3-5-haiku-latest

NEXUS_DEEPSEEK_API_KEY=
NEXUS_DEEPSEEK_MODEL=deepseek-chat

NEXUS_MISTRAL_API_KEY=
NEXUS_MISTRAL_MODEL=mistral-small-latest
